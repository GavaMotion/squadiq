# Local secrets for Supabase Edge Functions (never committed to git)
# Copy to supabase/.env and fill in real values:
#   cp supabase/.env.example supabase/.env
#
# For production, set the same vars via:
#   supabase secrets set NAME=value

ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Apple In-App Purchase (verify-apple-receipt) ────────────────────────────
# The iOS app's bundle identifier — Edge Function rejects JWS with a different
# bundleId claim. Find it in Xcode: target → General → Bundle Identifier.
APPLE_BUNDLE_ID=com.gavamotion.squadiq

# Optional: override the pinned Apple Root CA - G3 SHA-256 fingerprint.
# Compute it from the official cert with:
#   curl -O https://www.apple.com/certificateauthority/AppleRootCA-G3.cer
#   openssl x509 -in AppleRootCA-G3.cer -inform DER -fingerprint -sha256 -noout
# (default hardcoded in the function; only set this if Apple ever rotates G3.)
# APPLE_ROOT_CA_G3_SHA256=
